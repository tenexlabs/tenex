{
  "name": "tenex",
  "version": "0.0.4",
  "description": "Founder-ready TanStack Start + Convex starter with Better Auth and component-first add-ons",
  "bin": {
    "tenex": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm exec -- ultracite check && npm run harness:check",
    "docs:generate": "node scripts/update-generated-docs.mjs",
    "fix": "npm exec -- ultracite fix",
    "harness:check": "node scripts/check-agent-harness.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && node ./dist/test/smoke.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "convex",
    "tanstack-start",
    "tanstack",
    "cursor",
    "scaffold",
    "template",
    "init"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "ts-morph": "^27.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "ultracite": "^7.0.12"
  },
  "files": [
    "dist",
    "tsconfig.json",
    "package.json",
    "LICENSE"
  ]
}
